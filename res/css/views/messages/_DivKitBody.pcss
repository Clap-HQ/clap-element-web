/* DivKit AI message rendering - remove padding and background from container */
.mx_EventTile:has(.mx_DivKitBody) .mx_EventTile_line {
    padding: 0 !important;
    background: transparent !important;
}

/* Ensure DivKit content has proper spacing */
.mx_DivKitBody {
    width: 100%;
}
